{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curriculum.schema.json",
  "title": "STJBS Coding curriculum",
  "description": "Editor hints for curriculum.json. The app's own check is src/curriculum.js (validateCurriculum); if the two ever disagree, the app wins. See CURRICULUM_FORMAT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "tracks"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "tracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/track" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$", "description": "Stable id. Never reuse or rename once published." },
    "https": { "type": "string", "pattern": "^https://\\S+$", "maxLength": 500 },
    "track": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "levels"],
      "properties": {
        "id": { "enum": ["python", "scratch"] },
        "title": { "type": "string", "maxLength": 80 },
        "levels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/level" } }
      }
    },
    "level": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "topics"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 120 },
        "overview": { "type": "string", "maxLength": 2000 },
        "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/topic" } }
      }
    },
    "topic": {
      "type": "object", "additionalProperties": false, "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 120 },
        "overview": { "type": "string", "maxLength": 2000 },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["title"],
          "properties": {
            "title": { "type": "string", "maxLength": 200 },
            "url": { "$ref": "#/$defs/https" },
            "licence": { "type": "string", "maxLength": 80 }
          }
        },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "maxLength": 120 },
              "overview": { "type": "string", "maxLength": 2000 },
              "slides": { "$ref": "#/$defs/https", "description": "Google Slides link, shared with stjbs.sch.id only." }
            }
          }
        },
        "snippets": {
          "type": "array", "description": "Python track only.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title", "code"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "maxLength": 120 },
              "code": { "type": "string", "maxLength": 5000 },
              "stdin": { "type": "array", "items": { "type": "string" }, "description": "Lines fed to input(), in order." }
            }
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "maxLength": 120 },
              "brief": { "type": "string", "maxLength": 2000 },
              "starter": { "type": "string", "maxLength": 5000 }
            }
          }
        }
      }
    }
  }
}
