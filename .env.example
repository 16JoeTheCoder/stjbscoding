# Copy this file to .env for local development (VS Code terminal: cp .env.example .env).
# For production, set the same names as build environment variables in Cloudflare (DEPLOY.md step 8).
# Values come from Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These identify the project; they are not secrets. Security comes from firestore.rules.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id

# Local development only: talk to the Firebase emulators instead of the real project.
# Leave unset (or false) in Cloudflare.
VITE_USE_EMULATORS=false
